---
// Not a map — a compass. Brisbane sits in the middle, and each family's home
// town is placed at its true great-circle bearing from Brisbane, at a distance
// drawn to scale. So the directions and the lengths are both real, and there
// are no invented coastlines to get wrong.
//
// Bearings and distances computed from these coordinates:
//   Brisbane -27.4698,153.0251 · London 51.5074,-0.1278 · Gračišće 45.1667,14.0333
//   Arienzo 41.0261,14.5044 · Rosario -32.9587,-60.6931 · Burgersdorp -30.9948,26.3269

const CX = 400, CY = 350, MAXKM = 17000, MAXR = 250;
const r = km => (km / MAXKM) * MAXR;
const pt = (km, bearing, extra = 0) => {
  const t = (bearing * Math.PI) / 180;
  return [CX + (r(km) + extra) * Math.sin(t), CY - (r(km) + extra) * Math.cos(t)];
};

const places = [
  { k: "britain",   slug: "darcy",       name: "England",      km: 16526, bear: 327.3,
    lab: [268, 118], anchor: "middle" },
  { k: "croatia",   slug: "defranceski", name: "Croatia",      km: 15907, bear: 309.7,
    lab: [220, 172], anchor: "middle" },
  { k: "italy",     slug: "falco",       name: "Italy",        km: 15961, bear: 302.8,
    lab: [187, 232], anchor: "end" },
  { k: "safrica",   slug: "booyzen",     name: "South Africa", km: 11401, bear: 224.8,
    lab: [266, 462], anchor: "end" },
  { k: "argentina", slug: "lerena",      name: "Argentina",    km: 12410, bear: 149.9,
    lab: [508, 502], anchor: "start" },
].map(p => ({ ...p, xy: pt(p.km, p.bear) }));

const rings = [5000, 10000, 15000];
const compass = [
  { t: "N", x: CX, y: 76 }, { t: "S", x: CX, y: 630 },
  { t: "E", x: 676, y: 357 }, { t: "W", x: 124, y: 357 },
];
const fmt = n => n.toLocaleString("en-GB");
---

<svg viewBox="0 0 800 700" role="img"
     aria-label="A compass centred on Brisbane. England lies 16,526 km to the north-west, Croatia 15,907 km north-west, Italy 15,961 km north-west, South Africa 11,401 km to the south-west and Argentina 12,410 km to the south-east.">

  <!-- distance rings -->
  {rings.map(km => (
    <circle cx={CX} cy={CY} r={r(km)} fill="none"
            stroke="var(--rule-2)" stroke-width="1.5" stroke-dasharray="3 7" />
  ))}
  {rings.map(km => (
    <text x={CX + 5} y={CY - r(km) + 4} fill="var(--ink-3)"
          style="font-family:var(--sans);font-size:11.5px;font-weight:700;paint-order:stroke;stroke:var(--panel);stroke-width:5px;stroke-linejoin:round">{fmt(km)} km</text>
  ))}

  <!-- compass points -->
  <line x1={CX} y1={CY - 268} x2={CX} y2={CY + 268} stroke="var(--rule)" stroke-width="1.5" />
  <line x1={CX - 268} y1={CY} x2={CX + 268} y2={CY} stroke="var(--rule)" stroke-width="1.5" />
  {compass.map(c => (
    <text x={c.x} y={c.y} text-anchor="middle" fill="var(--ink-3)"
          style="font-family:var(--serif);font-size:20px;font-weight:600">{c.t}</text>
  ))}

  <!-- the five journeys -->
  {places.map(p => (
    <line x1={CX} y1={CY} x2={p.xy[0]} y2={p.xy[1]}
          stroke={`var(--${p.k})`} stroke-width="4" stroke-linecap="round"
          stroke-dasharray="2 10" opacity="0.95" />
  ))}

  <!-- where each family started -->
  {places.map(p => (
    <a href={`${Astro.props.base}${p.slug}/`}>
      <circle cx={p.xy[0]} cy={p.xy[1]} r="11" fill={`var(--${p.k})`} stroke="var(--panel)" stroke-width="3.5" />
      <text x={p.lab[0]} y={p.lab[1]} text-anchor={p.anchor} fill={`var(--${p.k}-deep)`}
            style="font-family:var(--sans);font-size:17px;font-weight:800;paint-order:stroke;stroke:var(--panel);stroke-width:5px;stroke-linejoin:round">{p.name}</text>
      <text x={p.lab[0]} y={p.lab[1] + 18} text-anchor={p.anchor} fill={`var(--${p.k})`}
            style="font-family:var(--sans);font-size:14px;font-weight:700;paint-order:stroke;stroke:var(--panel);stroke-width:5px;stroke-linejoin:round">{fmt(p.km)} km</text>
    </a>
  ))}

  <!-- home -->
  <circle cx={CX} cy={CY} r="26" fill="none" stroke="var(--sun)" stroke-width="3" opacity="0.6" />
  <circle cx={CX} cy={CY} r="15" fill="var(--sun)" stroke="var(--panel)" stroke-width="4" />
  <text x={CX} y={CY + 48} text-anchor="middle" fill="var(--ink)"
        style="font-family:var(--serif);font-size:24px;font-weight:600;paint-order:stroke;stroke:var(--panel);stroke-width:6px;stroke-linejoin:round">Brisbane</text>
  <text x={CX} y={CY + 66} text-anchor="middle" fill="var(--safrica)"
        style="font-family:var(--sans);font-size:12px;font-weight:800;letter-spacing:.12em;paint-order:stroke;stroke:var(--panel);stroke-width:5px;stroke-linejoin:round">HOME</text>
</svg>
