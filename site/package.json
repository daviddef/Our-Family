{
  "name": "our-family",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4325",
    "build": "astro build && npm run sitemap && npm run check:living && npm run check:kit",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "preview": "astro preview --port 4325",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --policy declared --declared src/data/living.json",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#9c66e9cb99a5c855388ec29240013cb230b0f30d",
    "astro": "^5.18.2"
  }
}
