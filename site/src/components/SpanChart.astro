---
// How far back each family can actually be proved, on one shared scale.
// Solid bar  = the direct line this site shows, from its oldest dated ancestor.
// Faded bar  = deeper still, but reached through the mothers, or not yet tested.

// The names used to sit in a gutter on the left. On a phone this chart has to
// scroll sideways, and the gutter — with every family's name in it — scrolled
// straight out of view. So the name now rides inside its own bar.
// The time axis stops at 620 so the last 280 units can carry the thing the
// chart was missing: where each line starts on the ground, and where all ten
// of them finish. Which is the same place.
const X0 = 1680, X1 = 2035, L = 34, R = 620, PX = 646;
const x = y => L + ((y - X0) / (X1 - X0)) * (R - L);

import lines from "../data/archive-lines.json";
import { cardKey, forename, startYear } from "../lib/ladders.js";

/* THE YEARS COME FROM THE ARCHIVES' CARDS, NOT FROM THIS FILE. A row names the family and the card its solid bar
   starts at; the year and the name are read from the snapshot (data/archive-lines.json), so a corrected year
   moves the bar. `ghost` is the card the faded bar reaches, by the same rule. `from` / `ghost` as numbers are
   for a bar that starts somewhere no card says (a family chart, a tree in England). */
const card = (fam, ref) => {
  const c = lines.families[fam].cards.find((c) => cardKey(c) === ref);
  if (!c) throw new Error(`SpanChart: ${fam} has no card ${ref} in the archive snapshot`);
  return c;
};
const bar = (k, name, fam, ref, at, extra = {}) => {
  const c = card(fam, ref);
  const from = extra.from ?? startYear(c.years);
  if (!from) throw new Error(`SpanChart: ${fam}/${ref} has no year; give one`);
  const ghost = typeof extra.ghost === "string" ? startYear(card(fam, extra.ghost).years) : extra.ghost;
  return { k, name, from, who: extra.who ?? forename(c.name), at, ghost, ghostNote: extra.ghostNote };
};
const rows = [
  // The Mazza archive marks the generations above 1785 in the Prostamo line as resting on the
  // family tree alone, so the solid bar starts where the paper does and 1697 is the ghost.
  bar("prostamo", "Prostamo", "prostamo", "domenico-prostamo-1820", "Briatico",
    { ghost: "franco-antonino-prostamo", ghostNote: "Franco Antonino \u2014 on the family tree, not in any register" }),
  bar("arena", "Arena", "arena", "orazio-arena-1751", "Scilla"),
  bar("britain", "D\u2019Arcy", "darcy", "robert-d-arcy", "Chatham"),
  bar("italy", "Falco", "falco", "pasquale-falco-of-pasquale-falco-chiara-rivetti", "Arienzo"),
  bar("croatia", "Defranceski", "defranceski", "giovanni-battista-defranceschi-1787", "Gra\u010di\u0161\u0107e",
    { from: 1787, who: "Giov. Battista", ghost: 1750, ghostNote: "Giovanni \u2014 on the family chart, not yet in a register" }),
  bar("safrica", "Booyzen", "booyzen", "petrus-jacobus-booysen", "the Cape",
    { from: 1788, ghost: 1683, ghostNote: "Downing, in England \u2014 untested" }),
  bar("mazza", "Mazza", "mazza", "mariano-mazza-1809", "Piedimonte"),
  bar("blazevic", "Bla\u017eevi\u0107", "blazevic", "toma-tomislav-blazevic", "Smokvica",
    { ghost: "matesa-blazevic", ghostNote: "Mate\u0161a \u2014 named on a family tree, not in a register" }),
  bar("argentina", "Lerena", "lerena", "pablo-armando-lerena", "Rosario",
    { ghost: "sancho-llerena-aguilar", ghostNote: "Sancho \u2014 a Llerena in the papers, but no paper joins him to Juan Carlos" }),
  bar("polistena", "Polistena", "polistena", "giovanni-polistena", "Scilla"),
].sort((a, b) => (b.k === "prostamo") - (a.k === "prostamo") || a.from - b.from);   // by where the solid bar starts; Prostamo, whose faded bar reaches furthest, first

const ticks = [1700, 1750, 1800, 1850, 1900, 1950, 2000];
const TOP = 54, H = 30, GAP = 52;
const bottom = TOP + rows.length * GAP + 6;

/* WRITTEN FROM THE ROWS, NOT TYPED BESIDE THEM. This sentence is what a screen
   reader is given instead of the drawing, and it had gone on saying «Prostamo
   reaches 1697» after the bar was corrected to start at 1820 where the paper
   does - so the picture and its description disagreed, and only one of them was
   checked by anybody. Where a line has a ghost, the description says so, in the
   same words the drawing uses. */
const label = "A chart of how far back each family is documented, and where each line begins and "
  + "ends. " + rows.map((r) =>
      `${r.name} ${r.from} at ${r.at}`
      + (r.ghost ? `, with ${r.ghostNote}, reaching ${r.ghost}` : "")
    ).join("; ")
  + ". Every one of the ten ends in Brisbane.";
---

<svg viewBox={`0 0 920 ${bottom + 46}`} role="img"
     aria-label={label}>

  {ticks.map(t => (
    <g>
      <line x1={x(t)} y1={TOP - 20} x2={x(t)} y2={bottom} stroke="var(--rule)" stroke-width="1.5" />
      <text x={x(t)} y={TOP - 28} text-anchor="middle" fill="var(--ink-3)"
            style="font-family:var(--sans);font-size:12.5px;font-weight:700">{t}</text>
    </g>
  ))}

  {rows.map((r, i) => {
    const y = TOP + i * GAP;
    return (
      <g>
        {r.ghost && (
          <rect x={x(r.ghost)} y={y + 5} width={x(r.from) - x(r.ghost)} height={H - 10} rx={5}
                fill={`var(--${r.k}-wash)`} />
        )}
        {r.ghost && (
          <text x={x(r.ghost) + 10} y={y + 20} fill={`var(--${r.k}-deep)`}
                style="font-family:var(--sans);font-size:12.5px;font-weight:800">{r.ghost}</text>
        )}

        {/* the deep tone, not the bright one — white sits on top of it */}
        <rect x={x(r.from)} y={y} width={x(2026) - x(r.from)} height={H} rx={8}
              fill={`var(--${r.k}-deep)`} />
        <text x={x(r.from) + 13} y={y + 21} fill="#fff"
              style="font-family:var(--serif);font-size:20px;font-weight:600">{r.name}</text>
        <text x={x(r.from) + 13 + r.name.length * 10.5} y={y + 20} fill="#fff"
              style="font-family:var(--sans);font-size:13px;font-weight:800;opacity:.85">{r.from}</text>

        <text x={PX} y={y + 13} fill={`var(--${r.k}-deep)`}
              style="font-family:var(--sans);font-size:14px;font-weight:800">{r.at} <tspan style="opacity:.55">→</tspan> Brisbane</text>
        <text x={PX} y={y + 28} fill="var(--ink-3)"
              style="font-family:var(--sans);font-size:12px;font-weight:700">from {r.who}</text>
      </g>
    );
  })}

  <text x={L} y={bottom + 32} fill="var(--ink-3)"
        style="font-family:var(--sans);font-size:13px;font-weight:700">Faded = older still, but through the mothers, or written on a family chart rather than in a register.</text>
</svg>
