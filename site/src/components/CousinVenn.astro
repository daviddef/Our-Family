---
// The whole idea in one picture: two circles, one per pair of children, and the
// two families in the overlap because their mothers are sisters.
// The lens is drawn by clipping one circle with the other, so the shape is exact.
const { base } = Astro.props;

const RX_ = 260, RY = 175, CY = 300, LX = 320, RX = 620;
const rowY = [231, 277, 323, 369];

const left = [
  { k: "safrica",   n: "Booyzen",     s: "booyzen" },
  { k: "argentina", n: "Lerena",      s: "lerena" },
  { k: "croatia",   n: "Defranceski", s: "defranceski" },
  { k: "blazevic",  n: "Blažević",    s: "blazevic" },
];
const both = [
  { k: "britain", n: "D’Arcy", s: "darcy" },
  { k: "italy",   n: "Falco",  s: "falco" },
];
const right = [
  { k: "mazza",     n: "Mazza",     s: "mazza" },
  { k: "prostamo",  n: "Prostamo",  s: "prostamo" },
  { k: "arena",     n: "Arena",     s: "arena" },
  { k: "polistena", n: "Polistena", s: "polistena" },
];

const pill = (cx, y, w) => ({ x: cx - w / 2, y: y - 18, w, h: 36 });
---

<svg viewBox="0 0 940 606" role="img"
     aria-label="Two overlapping circles. The left holds Booyzen, Lerena, Defranceski and Blažević, which belong to ADD and MCD. The right holds Mazza, Prostamo, Arena and Polistena, which belong to RFM and MJM. D’Arcy and Falco sit in the overlap because they belong to all four cousins.">
  <defs>
    <clipPath id="lensclip"><ellipse cx={LX} cy={CY} rx={RX_} ry={RY} /></clipPath>
  </defs>

  <!-- the two pairs, named outside the circles so nothing collides -->
  <text x={200} y={82} text-anchor="middle" fill="var(--croatia-deep)"
        style="font-family:var(--serif);font-size:30px;font-weight:600">ADD &amp; MCD</text>
  <text x={200} y={104} text-anchor="middle" fill="var(--croatia-deep)"
        style="font-family:var(--sans);font-size:11.5px;font-weight:800;letter-spacing:.11em;text-transform:uppercase">Four families of their own</text>

  <text x={740} y={82} text-anchor="middle" fill="var(--mazza-deep)"
        style="font-family:var(--serif);font-size:30px;font-weight:600">RFM &amp; MJM</text>
  <text x={740} y={104} text-anchor="middle" fill="var(--mazza-deep)"
        style="font-family:var(--sans);font-size:11.5px;font-weight:800;letter-spacing:.11em;text-transform:uppercase">Four families of their own</text>

  <ellipse cx={LX} cy={CY} rx={RX_} ry={RY} fill="var(--croatia-wash)" opacity="0.62" />
  <ellipse cx={RX} cy={CY} rx={RX_} ry={RY} fill="var(--mazza-wash)" opacity="0.62" />
  <ellipse cx={RX} cy={CY} rx={RX_} ry={RY} fill="var(--sun-wash)" clip-path="url(#lensclip)" />
  <ellipse cx={LX} cy={CY} rx={RX_} ry={RY} fill="none" stroke="var(--croatia)" stroke-width="4" />
  <ellipse cx={RX} cy={CY} rx={RX_} ry={RY} fill="none" stroke="var(--mazza)" stroke-width="4" />

  {left.map((f, i) => {
    const p = pill(200, rowY[i], 196);
    return (
      <a href={`${base}${f.s}/`}>
        <rect x={p.x} y={p.y} width={p.w} height={p.h} rx={18}
              fill={`var(--${f.k}-wash)`} stroke={`var(--${f.k})`} stroke-width="2.5" />
        <text x={200} y={rowY[i] + 7} text-anchor="middle" fill={`var(--${f.k}-deep)`}
              style="font-family:var(--serif);font-size:20px;font-weight:600">{f.n}</text>
      </a>
    );
  })}

  {right.map((f, i) => {
    const p = pill(740, rowY[i], 196);
    return (
      <a href={`${base}${f.s}/`}>
        <rect x={p.x} y={p.y} width={p.w} height={p.h} rx={18}
              fill={`var(--${f.k}-wash)`} stroke={`var(--${f.k})`} stroke-width="2.5" />
        <text x={740} y={rowY[i] + 7} text-anchor="middle" fill={`var(--${f.k}-deep)`}
              style="font-family:var(--serif);font-size:20px;font-weight:600">{f.n}</text>
      </a>
    );
  })}

  <!-- the overlap -->
  <text x={470} y={196} text-anchor="middle" fill="#8C6504"
        style="font-family:var(--sans);font-size:11.5px;font-weight:800;letter-spacing:.11em;text-transform:uppercase">Shared by</text>
  <text x={470} y={214} text-anchor="middle" fill="#8C6504"
        style="font-family:var(--sans);font-size:11.5px;font-weight:800;letter-spacing:.11em;text-transform:uppercase">all four</text>

  {both.map((f, i) => {
    const y = rowY[i + 1];
    const p = pill(470, y, 152);
    return (
      <a href={`${base}${f.s}/`}>
        <rect x={p.x} y={p.y} width={p.w} height={p.h} rx={18}
              fill={`var(--${f.k}-wash)`} stroke={`var(--${f.k})`} stroke-width="2.5" />
        <text x={470} y={y + 7} text-anchor="middle" fill={`var(--${f.k}-deep)`}
              style="font-family:var(--serif);font-size:20px;font-weight:600">{f.n}</text>
      </a>
    );
  })}

  <rect x={356} y={508} width={228} height={34} rx={17} fill="var(--sun)" />
  <text x={470} y={531} text-anchor="middle" fill="var(--ink)"
        style="font-family:var(--sans);font-size:14px;font-weight:800">…because the mums are twins</text>

  <text x={470} y={576} text-anchor="middle" fill="var(--ink-2)"
        style="font-family:var(--sans);font-size:15.5px">Ten families. Two belong to everybody. Eight belong to one pair or the other.</text>
</svg>
