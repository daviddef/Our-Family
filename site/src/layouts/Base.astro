---
import { u } from "../lib/url.js";
import { families } from "../data/families.js";
const { title, dek, key } = Astro.props;
const SITE = "Our Family";
const here = Astro.url.pathname;
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? "Our Family — where we come from" : `${title} — ${SITE}`}</title>
<meta name="description" content={dek ?? "Five families, four continents, two boys in Brisbane — a family story told for children. Living people are named by initial only."} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;0,600;1,500&family=Nunito:wght@400;700;800&display=swap" />
<link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title === SITE ? "Our Family — where we come from" : `${title} — ${SITE}`} />
<meta property="og:description" content={dek ?? "Five families, four continents, two boys in Brisbane — a family story told for children."} />
<meta property="og:image" content={new URL(u("/og.png"), Astro.site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="stylesheet" href={u("/styles.css")} />
</head>
<body class={key ? `c-${key}` : ""}>

<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>Our <em>Family</em></a>
    <nav aria-label="The five families">
      <a href={u("/")} class={here === u("/") ? "on c-sun" : ""}>Home</a>
      {families.map(f => (
        <a href={u(`/${f.slug}/`)} class={`c-${f.key} ${here === u(`/${f.slug}/`) ? "on" : ""}`}>{f.name}</a>
      ))}
    </nav>
  </div>
</header>

<main><slot /></main>

<footer class="site">
  <div class="wrap">
    <p><strong>Our Family</strong> is the children's door into five grown-up research archives — the
    Defranceski, the Falco, the Lerena, the Booyzen and the D'Arcy. Every fact on this site was carried
    over from one of them, where you can see the actual documents it came from.</p>
    <div class="flinks">
      {families.map(f => <a href={f.archive}>{f.archiveName} →</a>)}
    </div>
    <p class="dim">Built for A and M, {new Date().getFullYear()}. Everyone still living is shown by initial only, with no dates. If anything here is wrong,
    it should be fixed — tell us and we will fix it.</p>
  </div>
</footer>

</body>
</html>
