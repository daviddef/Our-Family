---
import Base from "../layouts/Base.astro";
import BigTree from "../components/BigTree.astro";
import WorldMap from "../components/WorldMap.astro";
import TreeMobile from "../components/TreeMobile.astro";
import Icon from "../components/Icon.astro";
import { u } from "../lib/url.js";
import { families, joining, numbers } from "../data/families.js";
---
<Base title="Our Family">

  <figure class="hero">
    <picture>
      <source media="(max-width:700px)" srcset={u("/hero-sm.webp")} />
      <img src={u("/hero.webp")} width="1800" height="713" fetchpriority="high" decoding="async"
           alt="One long imaginary landscape joining every place this family came from, with a pale road running through it. From the left: a stone hill village in Istria with a stonecutter's mallet; a bare grey mountain with packhorses and a boat at a stone quay; a green Italian valley with a white church and a falcon overhead; a smoking volcano with a village in orange groves on its slopes; a castle on a rock above swordfish boats with tall prows; a white town above a beach; an English dockyard with a tall ship; a dry plain with horses, a windmill, a railed monument and a ship far out; and on the right a Queenslander house on stilts with a mango tree." />
    </picture>
    <div class="cap">
      <div class="wrap">
        <h1>Ten families,<br />four <span>cousins</span>.</h1>
        <p class="lead">Alessio and Mateo were born in Brisbane, and so were their cousins Rocco
        and Mia. The people the four of you come from lived on four different continents.</p>
        <p class="lead">A stonecutter on a Croatian hill. A carrier who led packhorses over a
        mountain. A farmer in Italy, a horse trainer in Argentina, a family on the dry plains of
        South Africa, a soldier who sailed from England — and, on your cousins’ side, a village at
        the foot of a volcano and a fishing town under a castle.</p>
        <p class="lead strong">Here is how all ten of them ended up in one city.</p>
      </div>
    </div>
  </figure>

  <div class="wrap">
    <p class="artnote">Ten families, one road. Everything in this picture is somewhere your
    family actually lived — the hill village, the mountain pass, the volcano, the castle on the
    rock, the English dockyard, the dry plain, and the house with the mango tree.</p>
  </div>

  <section>
    <div class="wrap">
      <div class="treewrap wide-only">
        <div class="scroll"><BigTree base={u("/")} /></div>
      </div>
      <div class="narrow-only"><TreeMobile base={u("/")} /></div>
      <p class="lead center" style="margin:20px auto 0;max-width:60ch">
        Start at the bottom, where you are, and climb. Every line going up is a real
        person who really lived. Tap any family to open its own page.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="nums">
        {numbers.map(n => (
          <div class="num"><b>{n.n}</b><span>{n.label}</span><i>{n.sub}</i></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker c-sun" style="--c:var(--safrica)">Pick a family</div>
      <h2>The ten families</h2>
      <p class="lead">Each one has its own colour, its own country, and its own best story.</p>
      <div class="grid g3" style="margin-top:30px">
        {families.map(f => (
          <a class={`fcard c-${f.key}`} href={u(`/${f.slug}/`)}>
            <div class="badge">
              <Icon name={f.icon} size={42} color="var(--c)" />
              <div>
                <h3>{f.name}</h3>
                <div class="where">{f.flagWord}</div>
              </div>
            </div>
            <p>{f.blurb}</p>
            <div class="go">Climb this tree →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker" style="--c:var(--safrica)">Real faces</div>
      <h2>Some of the people</h2>
      <p class="lead">These are photographs of people you are actually related to. The oldest of them
      was born more than a hundred and sixty years ago.</p>
      <div class="faces">
        {families.map(f => (
          <a class={`face c-${f.key}`} href={u(`/${f.slug}/`)}>
            {f.photos.length > 0 ? (
              <img src={u(`/photos/${f.photos[0].src}`)} alt={f.photos[0].alt}
                   width={f.photos[0].w} height={f.photos[0].h} loading="lazy" decoding="async" />
            ) : (
              <div class="noface" aria-hidden="true">?</div>
            )}
            <b>{f.photos.length > 0 ? f.photos[0].who : "No photo yet"}</b>
            <span>{f.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker" style="--c:var(--safrica)">The big journey</div>
      <h2>How far, and which way</h2>
      <p class="lead">Brisbane is in the middle. Each family sits in the exact direction you
      would have to set off in to reach their home town — and the lines are drawn to scale, so the
      longer the line, the further away it really is.</p>
      <div class="mapwrap"><div class="scroll"><WorldMap base={u("/")} /></div></div>
      <p class="cap">Croatia has one pin in two colours, because two of the ten families —
      Defranceski and Blažević — both come from there, about 70 km apart.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker" style="--c:var(--safrica)">More to poke about in</div>
      <h2>Six more ways in</h2>
      <div class="grid g3" style="margin-top:26px">
        {[["/cousins/","👦👧","You and your cousins","Half your tree is the same as theirs. Half is not"],
          ["/journeys/","🚢","The journeys","133 days at sea, and why each family left at all"],
          ["/places/","🏔️","The places","A town so windy it can knock a lorry over"],
          ["/picture/","🔍","Find it","Eleven things hidden in the picture on this page"],
          ["/cards/","🃏","The cards","One card for every ancestor with a name and a date"],
          ["/words/","🗣️","Family words","Trhonoša. Bura. Lapicida. How to say them"],
          ["/when/","⏳","When","How far back each family goes, and 25 moments in order"]].map(([h,e,t,d]) => (
          <a class="waycard" href={u(h)}>
            <span class="wemoji" aria-hidden="true">{e}</span>
            <b>{t}</b>
            <span>{d}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="deep c-sun">
        <div>
          <div class="t">What did they all do all day?</div>
          <div class="s">Stonecutters, a man who led packhorses over a mountain, a cigar roller,
          a tailor on Bond Street, a racehorse trainer, a surveyor who helped map Melbourne, and
          a soldier who guarded a convict ship.</div>
        </div>
        <a class="btn sun" href={u("/jobs/")}>See all the jobs →</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker" style="--c:var(--safrica)">The story</div>
      <h2>How they all came together</h2>
      <p class="lead">Families join together when two people meet. And right at the end, two
      sisters who were born on the same day married two men whose families had nothing whatsoever
      in common.</p>
      <div class="joins" style="margin-top:28px">
        {joining.map(j => (
          <div class={`join ${j.big ? "big" : ""} ${j.boy ? "boy" : ""}`}>
            <div class={`yr ${j.year === "then" ? "then" : ""}`}>{j.year}</div>
            <div>
              <div class="txt">{j.text}</div>
              <div class="dots" aria-hidden="true">
                {j.keys.map(k => <i style={`background:var(--${k})`}></i>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="deep c-sun">
        <div>
          <div class="t">Want the whole grown-up version?</div>
          <div class="s">Every single fact on this site came out of seven much bigger archives,
          where you can read the actual old documents — the church books, the ships' papers,
          the wills and the gravestones.</div>
          <div class="flinks">
            {families.map(f => <a href={f.archive}>{f.archiveName} →</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
