---
// The same tree as BigTree, laid out vertically for a phone. The wide SVG is
// 2200 units across and unreadable on a narrow screen, so this replaces it:
// read from the top down — families into grandparents, grandparents into a
// parent, and each pair of parents into their two children.
//
// The middle block is the one all four cousins share.
const { base } = Astro.props;

const sides = [
  {
    title: "Rocco & Mia’s dad’s side",
    parent: { rel: "Dad", name: "MRM" },
    groups: [
      { gp: { rel: "Grandpa", name: "Frank", k: "mazza" },
        fams: [
          { k: "mazza", slug: "mazza", name: "Mazza", land: "Sicily", gg2: "Salvatore", ggp: "Sebastiano" },
          { k: "prostamo", slug: "prostamo", name: "Prostamo", land: "Calabria", gg2: "Francessco", ggp: "Domenica" },
        ] },
      { gp: { rel: "Grandma", name: "Nancy", k: "arena" },
        fams: [
          { k: "arena", slug: "arena", name: "Arena", land: "Calabria", gg2: "Giuseppe", ggp: "Rocco" },
          { k: "polistena", slug: "polistena", name: "Polistena", land: "Calabria", gg2: "Giovanni", ggp: "Angela" },
        ] },
    ],
  },
  {
    title: "The side all four of you share",
    shared: true,
    parent: { rel: "Their daughters — twins", name: "SFD & CAD" },
    groups: [
      { gp: { rel: "Grandpa", name: "IKD", k: "britain" },
        fams: [{ k: "britain", slug: "darcy", name: "D’Arcy", land: "England & Ireland", gg2: "Lindesay", ggp: "Kenneth" }] },
      { gp: { rel: "Grandma", name: "GF", k: "italy" },
        fams: [{ k: "italy", slug: "falco", name: "Falco", land: "Italy", gg2: "Carmine Antonio", ggp: "Carmine" }] },
    ],
  },
  {
    title: "Alessio & Mateo’s dad’s side",
    parent: { rel: "Dad", name: "DID" },
    groups: [
      { gp: { rel: "Grandma", name: "CAL", k: "argentina" },
        fams: [
          { k: "safrica", slug: "booyzen", name: "Booyzen", land: "South Africa", gg2: "George", ggp: "Catherine" },
          { k: "argentina", slug: "lerena", name: "Lerena", land: "Argentina", gg2: "Pablo Armando", ggp: "Nuno" },
        ] },
      { gp: { rel: "Grandpa", name: "Ivan", k: "croatia" },
        fams: [
          { k: "croatia", slug: "defranceski", name: "Defranceski", land: "Croatia", gg2: "Anton", ggp: "Ivan" },
          { k: "blazevic", slug: "blazevic", name: "Blažević", land: "Croatia", gg2: "Ljubomir", ggp: "Hedviga" },
        ] },
    ],
  },
];

const pairs = [
  { initials: ["RFM", "MJM"], from: "MRM and SFD" },
  { initials: ["ADD", "MCD"], from: "DID and CAD" },
];
---

<div class="mtree">
  {sides.map(side => (
    <section class={`mside ${side.shared ? "is-shared" : ""}`}>
      <h3>{side.title}</h3>
      {side.groups.map(g => (
        <div class="mgroup">
          {g.fams.map(f => (
            <a class={`mfam c-${f.k}`} href={`${base}${f.slug}/`}>
              <span class="bar" aria-hidden="true"></span>
              <span class="nm">{f.name}</span>
              <span class="ld">{f.land}</span>
              <span class="gg"><em>{f.gg2}</em>{f.ggp}</span>
            </a>
          ))}
          <div class={`mgp c-${g.gp.k}`}>
            <span class="arw" aria-hidden="true">↓</span>
            <b>{g.gp.rel}</b><i>{g.gp.name}</i>
          </div>
        </div>
      ))}
      <div class="mparent">
        <span class="arw" aria-hidden="true">↓</span>
        <b>{side.parent.rel}</b><i>{side.parent.name}</i>
      </div>
    </section>
  ))}

  <div class="mkids">
    {pairs.map(p => (
      <div class="mpair">
        <small>{p.from}</small>
        <div class="pair">{p.initials.map(i => <span>{i}</span>)}</div>
      </div>
    ))}
    <small class="mplace">Brisbane, Australia</small>
  </div>
</div>
