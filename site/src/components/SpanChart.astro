---
// How far back each family can actually be proved, on one shared scale.
// Solid bar  = the direct line this site shows, from its oldest dated ancestor.
// Faded bar  = deeper still, but reached through the mothers, or not yet tested.

const X0 = 1680, X1 = 2035, L = 150, R = 880;
const x = y => L + ((y - X0) / (X1 - X0)) * (R - L);

const rows = [
  { k: "britain",   name: "D’Arcy",      from: 1751, who: "Robert" },
  { k: "italy",     name: "Falco",       from: 1767, who: "Pasquale" },
  { k: "croatia",   name: "Defranceski", from: 1787, who: "Giov. Battista",
    ghost: 1750, ghostNote: "Giovanni — on the family chart, not yet in a register" },
  { k: "safrica",   name: "Booyzen",     from: 1788, who: "Petrus Jacobus",
    ghost: 1683, ghostNote: "Downing, in England — untested" },
  { k: "blazevic",  name: "Blažević",    from: 1838, who: "Toma",
    ghost: 1690, ghostNote: "Karlobag, through the mothers" },
  { k: "argentina", name: "Lerena",      from: 1882, who: "Bob" },
];

const ticks = [1700, 1750, 1800, 1850, 1900, 1950, 2000];
const TOP = 54, H = 30, GAP = 52;
const bottom = TOP + rows.length * GAP + 6;
---

<svg viewBox={`0 0 920 ${bottom + 46}`} role="img"
     aria-label="A chart of how far back each family is documented. D’Arcy reaches 1751, Falco 1767, Defranceski 1787 (and 1750 on a family chart), Booyzen 1788 (and 1683 through an untested English line), Blažević 1838 (and about 1690 through the mothers at Karlobag), and Lerena 1882.">

  {ticks.map(t => (
    <g>
      <line x1={x(t)} y1={TOP - 20} x2={x(t)} y2={bottom} stroke="var(--rule)" stroke-width="1.5" />
      <text x={x(t)} y={TOP - 28} text-anchor="middle" fill="var(--ink-3)"
            style="font-family:var(--sans);font-size:12.5px;font-weight:700">{t}</text>
    </g>
  ))}

  {rows.map((r, i) => {
    const y = TOP + i * GAP;
    return (
      <g>
        <text x={L - 14} y={y + 20} text-anchor="end" fill={`var(--${r.k}-deep)`}
              style="font-family:var(--serif);font-size:20px;font-weight:600">{r.name}</text>

        {r.ghost && (
          <rect x={x(r.ghost)} y={y + 5} width={x(r.from) - x(r.ghost)} height={H - 10} rx={5}
                fill={`var(--${r.k})`} opacity="0.22" />
        )}
        {r.ghost && (
          <text x={x(r.ghost) + 10} y={y + 20} fill={`var(--${r.k}-deep)`}
                style="font-family:var(--sans);font-size:12.5px;font-weight:800">{r.ghost}</text>
        )}

        <rect x={x(r.from)} y={y} width={x(2026) - x(r.from)} height={H} rx={8}
              fill={`var(--${r.k})`} opacity="0.9" />
        <text x={x(r.from) + 11} y={y + 20} fill="#fff"
              style="font-family:var(--sans);font-size:13.5px;font-weight:800">{r.from}</text>
        <text x={x(2026) - 11} y={y + 20} text-anchor="end" fill="#fff"
              style="font-family:var(--sans);font-size:12px;font-weight:800;letter-spacing:.06em">{r.who.toUpperCase()} → NOW</text>
      </g>
    );
  })}

  <text x={L} y={bottom + 32} fill="var(--ink-3)"
        style="font-family:var(--sans);font-size:13px;font-weight:700">Faded = older still, but through the mothers, or written on a family chart rather than in a register.</text>
</svg>
